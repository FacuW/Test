{
  "id": null,
  "title": "Sistema de Monitoreo - TP1",
  "tags": ["monitoring", "tp1"],
  "style": "dark",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage (%)",
      "type": "stat",
      "targets": [
        {
          "expr": "monitoring_cpu_usage_percent",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          }
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "CPU User vs System (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "monitoring_cpu_user_percent",
          "legendFormat": "User Time",
          "refId": "A"
        },
        {
          "expr": "monitoring_cpu_system_percent",
          "legendFormat": "System Time",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "Memory Used (GB)",
      "type": "stat",
      "targets": [
        {
          "expr": "monitoring_memory_used_bytes / 1024 / 1024 / 1024",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 4},
              {"color": "red", "value": 6}
            ]
          }
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 4,
      "title": "Memory Total vs Free (GB)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "monitoring_memory_total_bytes / 1024 / 1024 / 1024",
          "legendFormat": "Total Memory",
          "refId": "A"
        },
        {
          "expr": "monitoring_memory_free_bytes / 1024 / 1024 / 1024",
          "legendFormat": "Free Memory",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 5,
      "title": "Load Average",
      "type": "timeseries",
      "targets": [
        {
          "expr": "monitoring_load_average_1m",
          "legendFormat": "1 minute",
          "refId": "A"
        },
        {
          "expr": "monitoring_load_average_5m",
          "legendFormat": "5 minutes",
          "refId": "B"
        },
        {
          "expr": "monitoring_load_average_15m",
          "legendFormat": "15 minutes",
          "refId": "C"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 6,
      "title": "Métricas Recolectadas (Total)",
      "type": "stat",
      "targets": [
        {
          "expr": "monitoring_metrics_collected_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 6}
    }
  ],
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s"
}